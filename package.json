{
  "name": "dsh-git-panel",
  "version": "0.1.3",
  "description": "Git panel for DeepSeek Harness: branches, commit graph, changes, commits and diffs. Forked from dsh-ide-git. | DeepSeek Harness Git 面板：分支、提交图谱、变更、提交与差异查看。基于 dsh-ide-git 二开。",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.6-alpha.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "files": [
    "icon.svg",
    "locale",
    "src/index.js",
    "src/client.js",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README_EN.md",
    "docs/screenshots",
    "LICENSE",
    "UPSTREAM.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test tests/smoke.mjs tests/api.test.mjs tests/graph.test.mjs tests/repos.test.mjs",
    "version": "node -e \"const fs=require('fs');const m=JSON.parse(fs.readFileSync('dsh.plugin.json','utf8'));const v=JSON.parse(fs.readFileSync('package.json','utf8')).version;m.version=v;fs.writeFileSync('dsh.plugin.json',JSON.stringify(m,null,2)+'\\n')\" && git add dsh.plugin.json",
    "probe:settings-card": "node scripts/settings-card-probe.mjs",
    "check:ssr": "node scripts/ssr-check.mjs",
    "check:syntax": "node --check src/index.js && node --check src/client.js"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-better-sidebar",
    "git",
    "git-gui",
    "source-control",
    "sidebar",
    "commit-graph"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.1.6-alpha.2",
    "dsh-better-sidebar": ">=0.12.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "icon": "./icon.svg",
  "upstream": {
    "repository": "https://github.com/KannaKuron/dsh-ide-git",
    "version": "0.18.2",
    "commit": "b4e4b5a176de7da9060d1225d9ed027a8df8472c"
  }
}
